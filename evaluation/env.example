# 评测配置模板
#
#   cp evaluation/env.example evaluation/.env  然后填值。
#   .env 被 .gitignore 忽略（.gitignore:138），key 可以直接写在里面。
#   本模板文件名不带前导点，所以会进 git —— 不要往这里写真 key。

# ═══════════════════════════════════════════════════════════════
# 被测模型（agent 侧）
# ═══════════════════════════════════════════════════════════════

# 自定义 Anthropic 兼容端点
ANTHROPIC_BASE_URL=http://xxx
ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxxxxxxxxxx

# 模型名。设了 ANTHROPIC_BASE_URL 时完整名会原样透传，
# 且 sonnet/opus/haiku/subagent 四个别名都会被指向它（claude_code.py:1445-1449）。
MODEL=

# 被测 agent。general_agent 是 claude-code 的子类，行为一致。
AGENT=general_agent

# ═══════════════════════════════════════════════════════════════
# Judge（verifier 侧）
# ═══════════════════════════════════════════════════════════════
#
# 789 题里 652 题靠 LLM rubric 打分，每题都要裁判模型。
# pujiang_ale100(100) 和 kernelbench(2) 完全不调模型。
# ws_hardest(35) 介于两者之间：逐字相同的单元格白判，其余仍要送去判等 ——
# 无 key 时这些单元格一律记为不等，分数是偏低的下界而不是报错。
#
# JUDGE_MODE 四选一：
#   anthropic  用官方 Anthropic 端点当裁判（推荐 —— 与数据集设计口径一致，结果可横向比）
#   openai     用 OpenAI 或任意 OpenAI 兼容端点当裁判
#   self       用被测端点自己当裁判（零额外成本，但有自评偏差，且 LiteLLM 兼容性未经验证）
#   none       不配裁判。适合 pujiang_ale100；ws_hardest 会拿到偏低的下界分
JUDGE_MODE=anthropic

# 裁判模型名，LiteLLM 的 provider/model 格式（如 anthropic/claude-sonnet-4-6）。
# 这是主入口：设一个值，两条评分管线都用它。留空则各任务用自己写死的默认值。
#
# 之所以下面还有个 WS_JUDGE_MODEL，是因为数据集里有两条互不相干的评分代码，
# 各读各的环境变量，本脚本只是替你把 JUDGE_MODEL 同时写进这两个口子：
#
#   rubric 652 题     tests/test.sh 调 harbor-rewardkit   读 REWARDKIT_JUDGE
#   ws_hardest 35 题  tests/evaluate.py:39                读 WS_JUDGE_MODEL
#                                                          ↓ 没设就回落到
#                                                          REWARDKIT_JUDGE
#                                                          ↓ 再没有就默认
#                                                          anthropic/claude-sonnet-4-6
JUDGE_MODEL=

# 例外口子：只给 ws_hardest 换裁判，不影响那 652 道 rubric 题。留空即跟随 JUDGE_MODEL。
#
# 什么时候值得填：ws_hardest 让裁判做的事只是判断两个单元格是否等价
# （"1,234" 和 "1234" 算不算同一个值），比 rubric 打分简单得多。
# 拿个便宜的小模型来干这个能省不少钱，而 rubric 那边仍留给强模型。
#   例：JUDGE_MODEL=anthropic/claude-sonnet-4-6
#       WS_JUDGE_MODEL=anthropic/claude-haiku-4-5
WS_JUDGE_MODEL=

# JUDGE_MODE=anthropic 时必填
JUDGE_ANTHROPIC_API_KEY=

# 裁判端点。留空走 Anthropic 官方；填了就是另一个 Anthropic 兼容代理当裁判。
# 与被测的 ANTHROPIC_BASE_URL 完全独立 —— verifier 不继承宿主机环境，
# 被测端点不会污染裁判（verifier/verifier.py:159-163）。
JUDGE_ANTHROPIC_BASE_URL=

# JUDGE_MODE=openai 时必填
JUDGE_OPENAI_API_KEY=
JUDGE_OPENAI_BASE_URL=

# ═══════════════════════════════════════════════════════════════
# 数据集与子集
# ═══════════════════════════════════════════════════════════════

# 数据集根目录（含 task_00001/ … task_00789/ 和 index.json）。
# 相对路径按 evaluation/ 解析。
# 数据集根目录（含 task_00001/ … 和 index.json），相对路径按 evaluation/ 解析
DATASET_PATH=

# 子集预设，二选一的快捷方式。留空表示按 SOURCES 走。
#   smoke          每个来源各取几题，验证链路是否通
#   deterministic  只跑不需要 judge 的 137 题（ws_hardest + ALE + kernelbench）
#   rubric         只跑需要 judge 的 652 题
#   all            全部 789 题
PRESET=smoke

# 按数据来源精确挑选，逗号分隔。PRESET 非空时本项被忽略。
# 可选值：sciprobench, env_long_horizon, ws_hardest, kernelbench_hard_operators,
#         pujiang_ale100, harbor_chem195, harbor_cs300, gdp_pdf
SOURCES=

# 额外的 glob 过滤，逗号分隔，匹配任务目录名（如 task_00042）。
# 与上面的来源筛选取交集。
TASK_INCLUDE=
TASK_EXCLUDE=

# 过滤后最多跑多少题。留空不限。
N_TASKS=

# ═══════════════════════════════════════════════════════════════
# 执行
# ═══════════════════════════════════════════════════════════════

# 执行环境：docker / daytona / modal / e2b / runloop / gke / novita
ENV_TYPE=docker

# 并发 trial 数。docker 本地跑建议 4-8，注意镜像构建也吃盘：
# task_00003 的 build context 有 1GB，task_00055 约 120MB。
N_CONCURRENT=4

# 每题重复次数。算 pass@k 或看方差时调大。
N_ATTEMPTS=1

# 超时倍率。sciprobench 单题 agent timeout 已经是 3600s，慢端点可以调到 1.5-2.0。
TIMEOUT_MULTIPLIER=1.0

# 结果输出目录，相对路径按 evaluation/ 解析。
JOBS_DIR=./jobs

# 每次都重建镜像。首跑设 false 让 docker 复用层缓存。
FORCE_BUILD=false

# 跑完删除容器。调试时设 false 以便进容器看现场。
DELETE=true

# 单题失败重试次数。
MAX_RETRIES=0
